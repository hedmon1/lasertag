# Copy to .env.production.local to point production builds (npm run build, firebase deploy)
# at a real Firebase project. The dev server ignores that file and keeps using the emulators.
# Firebase console: Project settings > Your apps > Web app.
# Also enable Authentication > Sign-in method > Anonymous, and create a Realtime Database.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: other locations for the person detector model and its runtime.
# VITE_PERSON_MODEL_URL=/models/efficientdet_lite0.tflite
# VITE_MEDIAPIPE_WASM_URL=/mediapipe/wasm
